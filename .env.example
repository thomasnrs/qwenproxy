PORT=3000
API_KEY=your_proxy_api_key
QWEN_EMAIL=your_email@example.com
QWEN_PASSWORD=your_password

# --- OpenRouter proxy (optional) ---
# Comma-separated pool of OpenRouter API keys to rotate across. Leave empty to
# disable the /openrouter routes. Free-tier keys are rate-limited per day, so
# multiple keys let the proxy fall back when one hits its limit.
OPENROUTER_KEYS=sk-or-v1-xxxxxxxx,sk-or-v1-yyyyyyyy
# Requests-per-second per key (proactive throttle — the proxy queues to stay
# under it). Default 1. Fractional allowed (0.5 = 1 req every 2s). Adjustable at
# runtime via the admin console: "or rps <key|#|all> <n>".
OPENROUTER_RPS=1
# Max time a request waits in the local RPS queue before returning 429 when all
# keys are saturated (ms). Default 30000.
# OPENROUTER_MAX_WAIT_MS=30000
# Optional ranking headers shown on openrouter.ai (both optional):
# OPENROUTER_REFERER=https://your-app.example
# OPENROUTER_TITLE=Your App Name
# Override the upstream base URL (rarely needed):
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- DeepSeek proxy (Playwright, optional) ---
# Add accounts with: npm run deepseek:login  (manual browser login)
# Set DEEPSEEK_DEBUG=1 to log the raw SSE chunks from chat.deepseek.com — useful
# while tuning the stream parser to the real format.
# DEEPSEEK_DEBUG=1
